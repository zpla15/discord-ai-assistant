# Discord bot token (Developer Portal > Bot > Token). Never commit the real value.
DISCORD_BOT_TOKEN=

# Only this Discord user ID may issue commands.
ALLOWED_USER_ID=

# Comma-separated list of Discord channel IDs the bot will respond in.
ALLOWED_CHANNEL_IDS=

# Absolute path to the directory (or umbrella of project directories) Claude
# Code CLI is allowed to work in. Keep this scoped to actual project folders —
# never point it at the bare home directory, which also holds ~/.ssh and
# ~/.claude/.credentials.json.
CLAUDE_WORKSPACE_DIR=/home/nova/projects

# Path to the claude CLI binary.
CLAUDE_BIN=/home/nova/.local/bin/claude

# Wall-clock timeout for a single Claude Code invocation, in milliseconds.
TASK_TIMEOUT_MS=300000

# Max combined stdout+stderr bytes buffered from the claude subprocess before it is killed.
CLAUDE_MAX_OUTPUT_BYTES=2000000

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
