# Discord bot token (Developer Portal > Bot > Token). Never commit the real value.
DISCORD_BOT_TOKEN=

# Only this Discord user ID may issue commands.
ALLOWED_USER_ID=

# Discord channels the bot will respond in, each mapped to its own confined
# Claude workspace directory: "channelId:/abs/path,channelId2:/abs/path2".
# Each channel is also its own independent conversation (session id is kept
# per channel and resumed automatically; send "!reset" in a channel to drop
# it). Keep paths scoped to actual project folders — never point one at the
# bare home directory, which also holds ~/.ssh and ~/.claude/.credentials.json.
CHANNEL_WORKSPACES=123456789012345678:/home/nova/projects/work,234567890123456789:/home/nova/projects/personal

# Path to the claude CLI binary.
CLAUDE_BIN=/home/nova/.local/bin/claude

# Wall-clock timeout for a single Claude Code invocation, in milliseconds.
TASK_TIMEOUT_MS=300000

# Max combined stdout+stderr bytes buffered from the claude subprocess before it is killed.
CLAUDE_MAX_OUTPUT_BYTES=2000000

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# JSON file that remembers each channel's last Claude session id across bot restarts (relative to the project dir).
SESSION_STORE_PATH=data/sessions.json
